# ==================================
# AfterBuy – .gitignore
# ==================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ---- Virtual Environment ----
venv/
.env
env/

# ---- Firebase ----
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- OS ----
desktop.ini
*.lnk

# ---- Logs ----
*.log
logs/

# ---- Environment Variables ----
.env
.env.local
.env.*.local

# ---- Node (if accidentally created) ----
node_modules/
package-lock.json

# ---- Data (large raw dumps / temp files) ----
data/*.tmp
data/*.bak
